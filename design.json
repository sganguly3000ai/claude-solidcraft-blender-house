  "materials": {
    "charcoal_panel": "dark charcoal panel cladding (through-coloured fibre-cement or aluminium rainscreen panels, 1200 x 600 module, open 10 mm joints, RAL 7021 tone): the main wall material on every facade of the house and the garage wing",
    "stone": "natural split-face stone, grey-buff, random-length coursed, about 100 mm deep: the entry pier, the entry cheek wall, the ground-floor wall beside the front door, the garage wing's street (south) and crook (west) walls up to +2.70, the two garden-terrace piers",
    "timber_soffit": "warm timber soffit boards (oiled thermally modified ash or western red cedar, 70 mm boards with 8 mm gaps) under every overhang, the porch / balcony and the terrace roof; downlights set into them",
    "glass_balustrade": "frameless laminated toughened glass, 1100 high above the deck, in a recessed base channel: the street balcony",
    "trim": "dark charcoal / black aluminium: window and door frames, fascias (400 deep), copings, flush sectional garage door",
    "front_door": "charcoal pivot door, 1000 x 2800, with a long vertical bar pull",
    "steel_post": "150 x 150 steel post, painted charcoal (garden terrace)",
    "roof_covering": "single-ply membrane, pale grey, on tapered insulation (all flat roofs); the balcony has porcelain pavers on pedestals",
    "interior_walls": "plastered blockwork / stud, 120 mm",
    "bed_edging": "split-face stone walling 200 mm thick with a 50 mm precast concrete coping, same stone as the house",
    "paving": "large-format grey concrete or porcelain pavers, 600 x 900",
    "driveway": "permeable dark grey block paving"
  },
