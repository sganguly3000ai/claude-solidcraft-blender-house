  "project": "Family house v3: dark modern flat-roof style, L-shaped with side-entry garage and rec room",
  "units": "mm",
  "origin": "south-west outside corner of the main house; x = east, y = north, z = up; z = 0 = ground-floor finished floor level",
  "conventions": {
    "wall_line": "start and end are the wall CENTRE LINE; thickness is split equally either side",
    "opening_position": "distance along the wall centre line from the wall start point to the near edge of the opening",
    "sill_z_head_z": "absolute heights above z = 0 (not relative to the floor), so they can be read straight off the elevations",
    "outlines": "polygons of [x, y] points in plan, anticlockwise or clockwise, not closed (the last point joins the first)",
    "feature_zones": "a stretch of a wall clad in another material: from / to = distance along the wall from its start, z_from / z_to = absolute heights",
    "angles": "degrees"
  },
